# Application
PORT=3000
NODE_ENV=development

# PostgreSQL independent VM or service endpoint
DATABASE_URL=postgresql://fds_app:CHANGE_ME@postgresql.fds.svc.cluster.local:5432/fdsdb
DATABASE_SSL=false

# Only trust HAProxy or another approved reverse proxy. Comma-separated CIDRs are allowed.
TRUSTED_PROXY_CIDRS=10.1.93.55/32
